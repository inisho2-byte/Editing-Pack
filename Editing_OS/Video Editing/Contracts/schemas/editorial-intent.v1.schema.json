{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arete.local/editing-os/contracts/editorial-intent/v1",
  "title": "Editing OS Editorial Intent v1",
  "type": "object",
  "required": [
    "contract_type",
    "schema_version",
    "project_id",
    "created_at",
    "production_context",
    "core_message",
    "promise",
    "proof_strategy",
    "payoff",
    "hook_hypothesis",
    "emotional_curve",
    "open_loop_ledger",
    "scenes",
    "ending_behavior"
  ],
  "properties": {
    "contract_type": {
      "const": "editorial-intent"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "production_context": {
      "$ref": "#/$defs/artifactReference"
    },
    "core_message": {
      "type": "string",
      "minLength": 1
    },
    "promise": {
      "type": "string",
      "minLength": 1
    },
    "proof_strategy": {
      "type": "string",
      "minLength": 1
    },
    "payoff": {
      "type": "string",
      "minLength": 1
    },
    "hook_hypothesis": {
      "type": "object",
      "required": [
        "mechanism",
        "claim",
        "viewer_question",
        "expected_behavior"
      ],
      "properties": {
        "mechanism": {
          "enum": [
            "outcome_first",
            "surprise",
            "unresolved_tension",
            "identity",
            "proof",
            "contrarian_claim",
            "loss_avoidance",
            "pattern_break",
            "other"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "viewer_question": {
          "type": "string",
          "minLength": 1
        },
        "expected_behavior": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "emotional_curve": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "position",
          "emotion",
          "intensity",
          "reason"
        ],
        "properties": {
          "position": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "emotion": {
            "type": "string",
            "minLength": 1
          },
          "intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "open_loop_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "loop_id",
          "question",
          "opened_scene_id",
          "payoff_scene_id",
          "stakes"
        ],
        "properties": {
          "loop_id": {
            "$ref": "#/$defs/identifier"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "opened_scene_id": {
            "$ref": "#/$defs/identifier"
          },
          "payoff_scene_id": {
            "$ref": "#/$defs/identifier"
          },
          "stakes": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "ending_behavior": {
      "type": "object",
      "required": [
        "type",
        "intended_aftertaste",
        "viewer_next_action"
      ],
      "properties": {
        "type": {
          "enum": [
            "resolution",
            "loop_back",
            "call_to_action",
            "open_question",
            "emotional_aftertaste"
          ]
        },
        "intended_aftertaste": {
          "type": "string",
          "minLength": 1
        },
        "viewer_next_action": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactReference": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "required": [
        "scene_id",
        "order",
        "role",
        "primary_job",
        "source_beat_ids",
        "viewer_state",
        "information_or_emotion_delivered",
        "proof",
        "open_loops",
        "visual_role",
        "caption_role",
        "graphic_role",
        "audio_role",
        "timing",
        "failure_conditions"
      ],
      "properties": {
        "scene_id": {
          "$ref": "#/$defs/identifier"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "stop_hook",
            "orientation",
            "problem_stakes",
            "curiosity_open_loop",
            "mechanism_explanation",
            "proof_demonstration",
            "contrast_transformation",
            "escalation",
            "payoff",
            "recovery_breath",
            "call_to_action",
            "loop_back"
          ]
        },
        "primary_job": {
          "type": "string",
          "minLength": 1
        },
        "source_beat_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "viewer_state": {
          "type": "object",
          "required": [
            "entering_question",
            "entering_emotion",
            "exit_knowledge",
            "exit_emotion"
          ],
          "properties": {
            "entering_question": {
              "type": "string",
              "minLength": 1
            },
            "entering_emotion": {
              "type": "string",
              "minLength": 1
            },
            "exit_knowledge": {
              "type": "string",
              "minLength": 1
            },
            "exit_emotion": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "information_or_emotion_delivered": {
          "type": "string",
          "minLength": 1
        },
        "proof": {
          "type": "object",
          "required": [
            "status",
            "description",
            "source_ids",
            "on_screen_evidence"
          ],
          "properties": {
            "status": {
              "enum": [
                "required",
                "waived",
                "not_applicable"
              ]
            },
            "description": {
              "type": "string"
            },
            "source_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              },
              "uniqueItems": true
            },
            "on_screen_evidence": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "required"
                  }
                }
              },
              "then": {
                "properties": {
                  "description": {
                    "minLength": 1
                  },
                  "source_ids": {
                    "minItems": 1
                  },
                  "on_screen_evidence": {
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "open_loops": {
          "type": "object",
          "required": [
            "opened",
            "advanced",
            "closed"
          ],
          "properties": {
            "opened": {
              "$ref": "#/$defs/idList"
            },
            "advanced": {
              "$ref": "#/$defs/idList"
            },
            "closed": {
              "$ref": "#/$defs/idList"
            }
          },
          "additionalProperties": false
        },
        "visual_role": {
          "type": "object",
          "required": [
            "mode",
            "purpose",
            "composition"
          ],
          "properties": {
            "mode": {
              "enum": [
                "talking_head",
                "b_roll",
                "demo",
                "screen_recording",
                "diagram",
                "motion_graphic",
                "text_only",
                "photograph",
                "generated_image",
                "mixed"
              ]
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "composition": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "caption_role": {
          "type": "object",
          "required": [
            "mode",
            "purpose"
          ],
          "properties": {
            "mode": {
              "enum": [
                "full_dialogue",
                "semantic_clause",
                "emphasis_only",
                "label",
                "none"
              ]
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "graphic_role": {
          "type": "object",
          "required": [
            "information_shape",
            "purpose"
          ],
          "properties": {
            "information_shape": {
              "enum": [
                "part_whole",
                "comparison",
                "change",
                "time",
                "process",
                "spatial",
                "hierarchy",
                "single_fact",
                "none"
              ]
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "audio_role": {
          "type": "object",
          "required": [
            "primary",
            "dialogue",
            "music",
            "ambience",
            "sound_effects",
            "silence_intent"
          ],
          "properties": {
            "primary": {
              "enum": [
                "dialogue",
                "music",
                "ambience",
                "sound_effect",
                "silence"
              ]
            },
            "dialogue": {
              "type": "string"
            },
            "music": {
              "type": "string"
            },
            "ambience": {
              "type": "string"
            },
            "sound_effects": {
              "type": "string"
            },
            "silence_intent": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "timing": {
          "type": "object",
          "required": [
            "planned_start_seconds",
            "planned_end_seconds",
            "duration_rationale"
          ],
          "properties": {
            "planned_start_seconds": {
              "type": "number",
              "minimum": 0
            },
            "planned_end_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "duration_rationale": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "failure_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "idList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "uniqueItems": true
    }
  }
}
